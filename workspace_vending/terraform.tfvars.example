# ==============================================================================
# terraform.tfvars.example
# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored
# ==============================================================================

databricks_account_id = "00000000-0000-0000-0000-000000000000"
aws_region            = "us-east-2"
resource_prefix       = "dbx-vend"

# Account console -> Groups -> numeric group id. Assigned ADMIN on every
# workspace unless overridden per entry. Comment out to skip admin binding.
admin_group_id = 123456789012345

workspaces = {
  dev = {
    deployment_name = "acme-dev" # -> acme-dev.cloud.databricks.com
    custom_tags     = { env = "dev", owner = "platform" }

    # 2 private subnets in different AZs + the Databricks security group.
    network = {
      vpc_id             = "vpc-0aaa1111bbb22222c"
      private_subnet_ids = ["subnet-0dev1111aaaa1111a", "subnet-0dev2222bbbb2222b"]
      security_group_ids = ["sg-0dev3333cccc3333c"]
    }

    # Consumed by the catalog-binding stub only — see modules/workspace/baseline.tf.
    workspace_catalogs = ["hr", "finance"]
  }

  prod = {
    deployment_name = "acme-prod"
    pricing_tier    = "ENTERPRISE"
    custom_tags     = { env = "prod", owner = "platform" }

    network = {
      vpc_id             = "vpc-0ddd4444eee55555f"
      private_subnet_ids = ["subnet-0prd1111aaaa1111a", "subnet-0prd2222bbbb2222b"]
      security_group_ids = ["sg-0prd3333cccc3333c"]
    }

    workspace_catalogs = ["hr", "finance", "programs"]
  }
}
